#!/usr/bin/env bash
# pmshot — fullscreen screenshot from the Plasma Mobile Librem 5 (librem5-pm).
#
# This KWin wlroots build exposes neither zwlr-screencopy (grim fails) nor the
# legacy org.kde.kwin.Screenshot API (gone); portal Screenshot requests get
# accepted but never answered. Working path: `spectacle -b -n -o` — BUT it
# returns a stale frozen frame while the session is locked (identical bytes
# for any content). Screen lock must be OFF (System Settings → or it was
# disabled on this device 2026-09-17). Verify freshness: consecutive shots
# should differ (a ticking clock suffices).
set -euo pipefail
OUT=${1:?usage: pmshot <local-path>}
ssh librem5-pm "
export XDG_RUNTIME_DIR=/run/user/10000 WAYLAND_DISPLAY=wayland-0
export DBUS_SESSION_BUS_ADDRESS=unix:path=\$(ls /tmp/dbus-* | head -1)
timeout 25 spectacle -b -n -o /tmp/pmshot.png
"
scp librem5-pm:/tmp/pmshot.png "$OUT" >/dev/null
echo "saved $OUT"
